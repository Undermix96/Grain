# Host path to the folder containing the original photos (read-only)
PHOTOS_PATH=./photos

# Host port exposed for the frontend
PORT=8080

# Internal backend port (used only between containers)
BACKEND_PORT=3001

# Timezone
TZ=Europe/Rome

# API rate limiting (requests per time window, per IP)
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute

# Rate limiting for expensive endpoints (image generation, manual refresh)
RATE_LIMIT_HEAVY_MAX=10
RATE_LIMIT_HEAVY_WINDOW=1 minute
